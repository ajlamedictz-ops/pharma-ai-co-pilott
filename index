<section class="wrap" id="izvori"><div class="sectionhead"><div class="eyebrow">Stručni izvori</div><h2>Gdje provjeriti farmakoterapijsku tvrdnju?</h2><p class="muted">Odabir izvora zavisi od pitanja. Dokumentaciju i preporuke treba provjeravati u aktuelnoj verziji i u odgovarajućem regulatornom kontekstu.</p></div><div class="grid two"><div class="source"><span class="tag">REGULATORNI IZVOR</span><h3>EMA</h3><p>Dokumentacija o lijekovima, indikacijama, sigurnosnim upozorenjima i sažecima karakteristika za centralno odobrene lijekove.</p><a href="https://www.ema.europa.eu/" target="_blank" rel="noopener noreferrer">Otvori EMA ↗</a></div><div class="source"><span class="tag">LITERATURA</span><h3>PubMed</h3><p>Pretraga biomedicinske literature; provjeriti dizajn studije, populaciju, datum i ograničenja dokaza.</p><a href="https://pubmed.ncbi.nlm.nih.gov/" target="_blank" rel="noopener noreferrer">Otvori PubMed ↗</a></div><div class="source"><span class="tag">BUBREŽNE BOLESTI</span><h3>KDIGO</h3><p>Smjernice za hroničnu bubrežnu bolest i povezane kliničke teme; koristiti tačnu verziju i preporuku.</p><a href="https://kdigo.org/guidelines/" target="_blank" rel="noopener noreferrer">Otvori KDIGO ↗</a></div><div class="source"><span class="tag">PODACI O LIJEKU</span><h3>SmPC / eMC</h3><p>Kontraindikacije, interakcije, upozorenja i doziranje prema odobrenom sažetku karakteristika lijeka; provjeriti lokalno važeći dokument.</p><a href="https://www.medicines.org.uk/emc" target="_blank" rel="noopener noreferrer">Otvori eMC ↗</a></div></div><div class="banner" style="margin-top:24px"><strong>Prije radionice:</strong> mentorica treba odobriti tačne izvore i odlomke za slučaj ibuprofena uz ACE inhibitor i diuretik. Ovaj vodič ne predstavlja kliničku smjernicu niti zamjenjuje individualnu procjenu.</div><div class="actions"><button class="btn" onclick="window.print()">Sačuvaj kao PDF / Štampaj</button><a class="btn alt" href="#uvod">Vrati se na početak ↑</a></div></section>
</main><footer><strong>PHARMA AI CO-PILOT CHALLENGE</strong><p>PITAJ AI. PROVJERI KAO FARMACEUT.</p><p class="small">Edukativni vodič · Konferencija „AI u farmaciji“ · Farmaceutski fakultet Univerziteta u Tuzli · 2026.</p><p class="small">Slučajevi su simulirani. Ne unositi lične podatke pacijenata u javne AI alate.</p></footer>
<script>
(function(){const $=id=>document.getElementById(id);const defaults={role:'Iz perspektive kliničke farmacije',context:'Edukativni pacijent, 74 godine, hronična bubrežna bolest, procijenjeni CrCl 30 mL/min, hipertenzija; koristi ramipril, furosemid i atorvastatin; bol u koljenu, razmatra ibuprofen.',task:'Identifikuj potencijalne interakcije, rizike za bubrežnu funkciju i dodatne podatke potrebne za procjenu.',limits:'Ne izmišljaj podatke i ne donosi konačnu terapijsku odluku.',verify:'Razdvoji činjenice i neizvjesnosti; predloži relevantne izvore za nezavisnu provjeru.'};function build(){let vals=Object.keys(defaults).map(k=>$(k).value.trim());if(vals.some(v=>!v)){ $('promptOutput').textContent='Popuni svih pet elemenata da bi upit bio potpun.';return;} $('promptOutput').textContent=vals[0]+', analiziraj sljedeći slučaj:\n\n'+vals[1]+'\n\nZADATAK: '+vals[2]+'\n\nOGRANIČENJA: '+vals[3]+'\n\nPROVJERA: '+vals[4];} $('build').addEventListener('click',build);$('resetPrompt').addEventListener('click',()=>{Object.entries(defaults).forEach(([k,v])=>$(k).value=v);build()});async function copy(s,el){try{await navigator.clipboard.writeText(s);el.textContent='Kopirano!';}catch(e){el.textContent='Automatsko kopiranje nije dostupno. Označi i kopiraj prikazani tekst.';}}$('copyPrompt').addEventListener('click',()=>copy($('promptOutput').textContent,$('copyStatus')));build();
const templates={poly:['Polifarmacija i interakcije','Analiziraj izmišljeni slučaj starijeg pacijenta s više hroničnih bolesti i sljedećom terapijom: [lijekovi, doze, indikacije]. Identifikuj moguće interakcije, terapijska dupliciranja, rizike i nedostajuće podatke. Razlikuj poznate činjenice od pretpostavki. Ne predlaži samostalnu promjenu terapije. Za svaku važnu tvrdnju predloži izvor za nezavisnu provjeru.'],renal:['Bubrežna funkcija i farmakokinetika','Za edukativni slučaj pacijenta s [dob, spol, masa, relevantni laboratorijski nalazi, dijagnoze, terapija] objasni koje podatke treba prikupiti prije procjene primjene lijeka [naziv]. Razlikuj CrCl i eGFR, navedi moguća ograničenja procjene i regulatorne izvore koje treba provjeriti. Ne izračunavaj konačnu individualnu dozu niti pretpostavljaj nedostajuće vrijednosti.'],evidence:['Provjera farmakoterapijske tvrdnje','Provjeri sljedeću farmakoterapijsku tvrdnju: [tvrdnja]. Razdvoji provjerljive dijelove, navedi koje vrste izvora su najrelevantnije (SmPC, smjernice, sistematski pregled, primarna studija), upozori na moguće pogrešne interpretacije i označi šta nije moguće potvrditi. Ne izmišljaj reference ili DOI; svaku tvrdnju treba nezavisno provjeriti u izvornom dokumentu.']};let active='poly';function renderTemplate(){ $('templateTitle').textContent=templates[active][0];$('templateText').textContent=templates[active][1];document.querySelectorAll('#promptTabs button').forEach(b=>b.classList.toggle('active',b.dataset.template===active));}document.querySelectorAll('#promptTabs button').forEach(b=>b.addEventListener('click',()=>{active=b.dataset.template;renderTemplate()}));$('copyTemplate').addEventListener('click',()=>copy($('templateText').textContent,$('templateStatus')));renderTemplate();
const checks=[...document.querySelectorAll('#checks input')];function updateChecks(){const n=checks.filter(c=>c.checked).length;$('checkCount').textContent=n+' od 6 provjera';$('progressFill').style.width=(n/6*100)+'%';}checks.forEach(c=>c.addEventListener('change',updateChecks));$('clearChecks').addEventListener('click',()=>{checks.forEach(c=>c.checked=false);updateChecks()});
const qs=[{q:'AI tvrdi da je kratkotrajna primjena ibuprofena sigurna bez dodatne procjene kod pacijenta koji uzima ramipril i furosemid. Šta je najprimjerenije?',a:['Prihvatiti tvrdnju jer je upotreba kratkotrajna.','Provjeriti bubrežnu funkciju, kliničke rizike i relevantne izvore prije stručne procjene.','Prihvatiti tvrdnju ako AI navede bilo kakvu referencu.'],correct:1,why:'Kombinacija NSAID-a, ACE inhibitora i diuretika može povećati rizik akutnog oštećenja bubrega. Trajanje primjene samo po sebi ne isključuje potrebu za procjenom.'},{q:'AI je naveo članak koji postoji, ali ne govori o pacijentima s bubrežnom bolešću. Šta zaključuješ?',a:['Postojanje članka potvrđuje tvrdnju.','Izvor je automatski dovoljan ako je nov.','Treba provjeriti relevantnost populacije i podržava li izvor konkretnu tvrdnju.'],correct:2,why:'Autentičnost izvora, njegova relevantnost i stvarno potkrepljenje tvrdnje tri su odvojena kriterija.'},{q:'Koji upit je prikladniji za stručnu edukativnu analizu?',a:['„Napiši mi najbolji lijek i dozu za ovog pacijenta.“','„Analiziraj rizike, nedostajuće podatke i izvore; ne donosi konačnu terapijsku odluku.“','„Odgovori kratko i bez upozorenja.“'],correct:1,why:'Strukturirani upit smanjuje nejasnoće i traži provjeru, ali i dalje ne garantuje tačan odgovor.'}];let qi=0,answered=false;function renderQuiz(){const q=qs[qi];answered=false;$('quizNumber').textContent='PITANJE '+(qi+1)+' / '+qs.length;$('quizQuestion').textContent=q.q;$('quizFeedback').innerHTML='';$('quizChoices').innerHTML='';q.a.forEach((a,i)=>{const b=document.createElement('button');b.className='choice';b.textContent=String.fromCharCode(65+i)+') '+a;b.addEventListener('click',()=>{if(answered)return;answered=true;b.classList.add('selected');const f=document.createElement('div');f.className='feedback';const strong=document.createElement('strong');strong.textContent=i===q.correct?'Tačno.':'Nije tačno.';const p=document.createElement('p');p.textContent=q.why;f.append(strong,p);$('quizFeedback').append(f);$('nextQuiz').disabled=false;$('nextQuiz').textContent=qi===qs.length-1?'Završi izazov':'Sljedeće pitanje →';});$('quizChoices').append(b)});$('nextQuiz').disabled=true;}$('nextQuiz').addEventListener('click',()=>{if(!answered)return;if(qi===qs.length-1){$('quizFeedback').innerHTML='<div class="feedback"><strong>Izazov završen!</strong><p>Primijeni istu logiku na svaki novi AI odgovor: kontekst → rizik → izvor → stručna procjena.</p></div>';$('nextQuiz').disabled=true;}else{qi++;renderQuiz()}});$('restartQuiz').addEventListener('click',()=>{qi=0;renderQuiz()});renderQuiz();})();
</script></body></html>
